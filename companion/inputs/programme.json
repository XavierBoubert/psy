            },
            {
              "valeur": 1,
              "libelle": "Entre une et deux minutes"
            },
            {
              "valeur": 2,
              "libelle": "Entre deux et quatre minutes"
            },
            {
              "valeur": 3,
              "libelle": "Il ira jusqu'au bout des cinq minutes"
            }
          ]
        },
        {
          "id": "cause",
          "enonce": "Qu'est-ce qui, selon toi, va te faire retirer le masque ?",
          "choix": [
            {
              "valeur": 0,
              "libelle": "Rien — je vais le garder jusqu'au bout"
            },
            {
              "valeur": 1,
              "libelle": "L'air passe mal"
            },
            {
              "valeur": 2,
              "libelle": "Le contact du masque sur le visage"
            },
            {
              "valeur": 3,
              "libelle": "Une toux"
            },
            {
              "valeur": 4,
              "libelle": "Autre chose"
            }
          ]
        }
