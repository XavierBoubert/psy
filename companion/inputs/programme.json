    {
      "id": "essai-a-deux",
      "titre": "Essai à deux — vérifier le déroulé de bout en bout",
      "type": "seance-duo",
      "rubrique": "therapie",
      "quand": "au_besoin",
      "duree_minutes": 3,
      "entrainement_requis": true,
      "signal_arret": "Xavier fait « non » de la main. On s'arrête, sans rien demander.",
      "avant": [
        "Le téléphone est dans tes mains, et il y reste du début à la fin.",
        "Xavier t'a montré le « non » de la main avant qu'on commence.",
        "La porte est fermée, et rien ne doit interrompre les trois prochaines minutes."
      ],
      "sequence": [
        {
          "pour": "aide",
          "consigne": "Assieds-toi en face de lui, à un mètre. Garde l'écran tourné vers toi.",
          "secondes": 30
        },
        {
          "pour": "patient",
          "consigne": "Lis à voix haute, mot pour mot : « Ceci est un essai du dispositif. Rien d'autre n'est demandé que de rester assis jusqu'au bout. »",
          "secondes": 30
        },
        {
          "pour": "aide",
          "consigne": "Ne parle pas pendant ce temps. L'écran passe seul à la consigne suivante.",
          "secondes": 45
        },
        {
          "pour": "patient",
          "consigne": "Lis à voix haute, mot pour mot : « L'essai est terminé. Le déroulé est allé jusqu'à sa dernière ligne. »",
          "secondes": 20
        }
      ],
      "arret": [
        "Il fait le signal d'arrêt → on s'arrête, on ne demande rien.",
        "Il ne répond plus aux consignes → on s'arrête, c'est un shutdown, pas un refus.",
        "Tu ne sais pas quoi faire → on s'arrête. Ne jamais improviser."
      ],
      "sortie_libre": true
    },
