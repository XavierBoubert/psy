#!/usr/bin/env bash
#
# kokoro — compiler, tester et déployer sans noyer la sortie.
#
# Gradle et adb parlent beaucoup : un build réussi, c'est déjà 40 lignes, et un échec s'enterre
# au milieu de centaines. Ce script renvoie **un verdict par étape**, et rien d'autre tant que
# tout va bien ; en cas d'échec, il ne remonte que l'extrait qui l'explique — les erreurs du
# compilateur, ou les tests tombés avec leur message d'assertion.
#
# 🔴 Le détail n'est jamais perdu : tout part dans build/kokoro.log, que `./kokoro journal` relit.
#
#   ./kokoro            tests, puis compilation, installation et ouverture
#   ./kokoro test       tests unitaires seuls
#   ./kokoro apk        compilation seule
#   ./kokoro pose       compilation, installation, ouverture, contrôle de plantage
#   ./kokoro lien       noue (ou renoue) le lien sans fil avec le téléphone
#   ./kokoro appairer   appairage sans fil, une seule fois : <IP:port> <code>
#   ./kokoro journal    les dernières lignes du dernier build
#   ./kokoro plantage   le tampon de plantage du téléphone
#
#   -v                  laisse Gradle parler comme d'habitude (pour creuser un cas tordu)

set -uo pipefail

RACINE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JOURNAL="$RACINE/build/kokoro.log"
SANSFIL="$RACINE/.kokoro-sansfil"
APK="$RACINE/app/build/outputs/apk/debug/app-debug.apk"
RESULTATS="$RACINE/app/build/test-results/testDebugUnitTest"

PAQUET="io.allonsy.kokoro"

# 🔴 L'écran qu'on ouvre est celui du lanceur, et lui seul : One UI refuse `am start` sur une
# activité non exportée. Depuis INTERFACE.md v2, c'est le monde — l'écran de contrôle est au bout
# de la roue dentée, et l'atelier du corps se prend depuis là.
ECRAN="$PAQUET/.monde.MondeActivity"

# Une explication d'échec qui dépasse ça n'est plus une explication, c'est le journal.
LIGNES_EXTRAIT=25

cd "$RACINE" || exit 1

# ————————————————————————————————————————————————————————————————————————————————————————————
# Affichage — une ligne par étape, toujours au même format
# ————————————————————————————————————————————————————————————————————————————————————————————

etat() { printf '%-9s %s\n' "$1" "$2"; }

echoue() {
    etat "$1" "ÉCHEC"
    expliquer
    exit 1
}

# L'extrait qui explique : les erreurs du compilateur, sinon les tests tombés, sinon Gradle.
expliquer() {
    local extrait
    extrait="$(erreurs_compilation)"
    [ -z "$extrait" ] && extrait="$(tests_tombes)"
    [ -z "$extrait" ] && extrait="$(souci_gradle)"
    [ -n "$extrait" ] && printf '%s\n' "$extrait"
    echo "— journal : ./kokoro journal"
}

erreurs_compilation() {
    [ -f "$JOURNAL" ] || return 0
    grep -E "^e: " "$JOURNAL" |
        sed -E 's|^e: file:///.*/(app/src)|\1|' |
        head -n "$LIGNES_EXTRAIT"
}

# Le journal Gradle ne donne que « <classe> > <test> FAILED » et le fichier fautif ; le message
# d'assertion, lui, est dans le XML de résultats — et c'est le seul endroit qui dit **pourquoi**.
tests_tombes() {
    [ -d "$RESULTATS" ] || return 0
    awk '
        function attribut(ligne, cle,   valeur) {
            if (match(ligne, cle "=\"[^\"]*\"") == 0) return ""
            valeur = substr(ligne, RSTART + length(cle) + 2, RLENGTH - length(cle) - 3)
            gsub(/&#10;|&#13;/, " ", valeur)
            gsub(/&lt;/, "<", valeur); gsub(/&gt;/, ">", valeur)
            gsub(/&quot;/, "\"", valeur); gsub(/&amp;/, "\\&", valeur)
            return valeur
        }
        /<testcase / { nom = attribut($0, "name"); classe = attribut($0, "classname") }
        /<(failure|error) / {
            sub(/^.*\./, "", classe)
            print classe " > " nom
            print "  " substr(attribut($0, "message"), 1, 180)
        }
    ' "$RESULTATS"/*.xml 2>/dev/null | head -n "$LIGNES_EXTRAIT"
}

souci_gradle() {
    [ -f "$JOURNAL" ] || return 0
    sed -n '/^\* What went wrong:/,/^\* Try:/p' "$JOURNAL" | head -n 15
}

# ————————————————————————————————————————————————————————————————————————————————————————————
# Gradle
# ————————————————————————————————————————————————————————————————————————————————————————————

lancer_gradle() {
    mkdir -p "$(dirname "$JOURNAL")"
    if [ "$VERBEUX" = 1 ]; then
        ./gradlew --console=plain "$@" 2>&1 | tee "$JOURNAL"
        return "${PIPESTATUS[0]}"
    fi
    ./gradlew --console=plain "$@" > "$JOURNAL" 2>&1
}

# Un test qui n'a pas été rejoué est un test dont rien n'a bougé — c'est une information, pas un
# succès à réafficher comme neuf.
resume_tests() {
    local total
    total="$(grep -ho 'tests="[0-9]*"' "$RESULTATS"/*.xml 2>/dev/null |
        tr -dc '0-9\n' | awk '{somme += $1} END {print somme + 0}')"
    case "$(grep -c "^> Task :app:testDebugUnitTest UP-TO-DATE" "$JOURNAL")" in
        0) echo "$total tests" ;;
        *) echo "$total tests (rien n'a bougé)" ;;
    esac
}

etape_tests() {
    lancer_gradle :app:testDebugUnitTest || echoue tests
    etat tests "ok        $(resume_tests)"
}

etape_apk() {
    lancer_gradle :app:assembleDebug || echoue apk
    [ -f "$APK" ] || echoue apk
    etat apk "ok        $(du -k "$APK" | awk '{printf "%.1f Mo", $1 / 1024}')"
}

# ————————————————————————————————————————————————————————————————————————————————————————————
# Le téléphone
# ————————————————————————————————————————————————————————————————————————————————————————————

telephone() { adb devices | awk 'NR > 1 && $2 == "device" { print $1; exit }'; }

modele_de() { adb -s "$1" shell getprop ro.product.model | tr -d '\r'; }

resume() {
    [ -f "$JOURNAL" ] || return 0
    tail -n 40 "$JOURNAL"
}

etape_pose() {
    local appareil modele
    appareil="$(telephone)"
    if [ -z "$appareil" ]; then
        nouer_lien
        appareil="$(telephone)"
    fi
    if [ -z "$appareil" ]; then
        etat pose "AUCUN TÉLÉPHONE"
        expliquer_lien
        exit 1
    fi
    modele="$(modele_de "$appareil")"

    if ! adb -s "$appareil" install -r -d "$APK" > "$JOURNAL.adb" 2>&1; then
        etat pose "ÉCHEC"
        tail -n 5 "$JOURNAL.adb"
        exit 1
    fi
    etat pose "ok        $modele"

    adb -s "$appareil" logcat -b crash -c > /dev/null 2>&1
    adb -s "$appareil" shell am start -n "$ECRAN" > /dev/null 2>&1
    attendre_ecran "$appareil" || { etat ouvert "PAS OUVERT"; exit 1; }

    local chute
    chute="$(adb -s "$appareil" logcat -b crash -d 2>/dev/null | grep -A8 -m1 "$PAQUET")"
    if [ -n "$chute" ]; then
        etat ouvert "PLANTAGE"
        printf '%s\n' "$chute" | head -n 10
        exit 1
    fi
    etat ouvert "${ECRAN##*.}"
}

attendre_ecran() {
    local essai
    for essai in $(seq 1 12); do
        if adb -s "$1" shell dumpsys activity activities 2>/dev/null |
            grep -q "ResumedActivity.*$ECRAN"; then
            return 0
        fi
        sleep 0.4
    done
    return 1
}

# ————————————————————————————————————————————————————————————————————————————————————————————
# Le lien sans fil — déployer par le Wi-Fi, sans câble
# ————————————————————————————————————————————————————————————————————————————————————————————
#
# 🔴 Un lien sans fil se noue une fois et se renoue tout seul : les autres commandes l'appellent
# quand aucun téléphone ne répond, et Xavier n'a rien à taper. Trois voies, dans cet ordre :
#
#   1. le câble, s'il est branché — il ne sert qu'à basculer adbd sur le port 5555, une fois ;
#   2. l'adresse retenue du dernier lien réussi ;
#   3. l'annonce mDNS du téléphone, quand le débogage sans fil vient d'être rallumé.
#
# Le port 5555 ne survit pas à un redémarrage du téléphone : il faut alors rebrancher une fois,
# ou repasser par `./kokoro appairer`. C'est Android qui l'impose, pas ce script.

# Un téléphone sans fil se reconnaît à son adresse : `10.0.0.5:5555`, jamais un numéro de série.
# Quand le câble est branché en même temps, les deux répondent — c'est le lien qu'on regarde ici.
telephone_sansfil() {
    adb devices | awk 'NR > 1 && $2 == "device" && $1 ~ /:/ { print $1; exit }'
}

adresse_retenue() { [ -f "$SANSFIL" ] && tr -d ' \r\n' < "$SANSFIL"; }

adresse_annoncee() {
    adb mdns services 2>/dev/null | awk '$2 == "_adb-tls-connect._tcp" { print $3; exit }'
}

# Le téléphone branché sait dire son adresse Wi-Fi ; c'est le seul service que le câble rend.
adresse_usb() {
    adb -s "$1" shell ip -f inet addr show wlan0 2>/dev/null |
        sed -nE 's/.*inet ([0-9.]+).*/\1:5555/p' | head -n 1
}

# Une adresse ne se retient que si elle a répondu — un lien mort réessayé à chaque build coûte
# plus cher qu'une découverte mDNS.
#
# ⚠️ La réponse d'adb se lit dans une variable, jamais dans un tube vers `grep -q` : grep sort au
# premier accord, adb prend un SIGPIPE, et `pipefail` retourne alors un échec sur un lien noué.
relier() {
    [ -n "$1" ] || return 1
    case "$(adb connect "$1" 2>&1)" in
        "connected to"* | "already connected"*) printf '%s\n' "$1" > "$SANSFIL" ;;
        *) return 1 ;;
    esac
}

nouer_lien() {
    local appareil adresse

    adresse="$(telephone_sansfil)"
    if [ -n "$adresse" ]; then
        printf '%s\n' "$adresse" > "$SANSFIL"
        return 0
    fi

    appareil="$(telephone)"
    if [ -n "$appareil" ]; then
        adresse="$(adresse_usb "$appareil")"
        adb -s "$appareil" tcpip 5555 > /dev/null 2>&1
        sleep 2
        relier "$adresse" && return 0
    fi

    relier "$(adresse_retenue)" && return 0
    relier "$(adresse_annoncee)" && return 0
    return 1
}

# Le débogage sans fil est une case à cocher sur le téléphone : aucun script ne peut la cocher
# à la place de Xavier, donc on dit exactement quoi faire plutôt que « aucun téléphone ».
expliquer_lien() {
    cat <<'FIN'
— sur le téléphone : Paramètres › Options de développement › Débogage sans fil › activer
— puis, une seule fois : ./kokoro appairer <IP:port> <code>
  (adresse et code sous « Appairer l'appareil avec un code d'appairage »)
— ou branche le câble une fois, puis : ./kokoro lien
FIN
}

etape_lien() {
    local appareil
    if ! nouer_lien; then
        etat lien "PAS DE LIEN"
        expliquer_lien
        exit 1
    fi
    appareil="$(telephone_sansfil)"
    etat lien "ok        $appareil  $(modele_de "$appareil")"
}

# L'adresse et le code d'appairage changent à chaque ouverture de l'écran : ils se lisent sur le
# téléphone au moment de taper la commande, ils ne se retiennent pas.
etape_appairer() {
    if [ -z "${1:-}" ] || [ -z "${2:-}" ]; then
        echo "kokoro appairer <IP:port> <code>"
        exit 1
    fi
    case "$(adb pair "$1" "$2" 2>&1)" in
        "Successfully paired"*) etat appairage "ok" ;;
        *)
            etat appairage "ÉCHEC"
            echo "— adresse et code changent à chaque ouverture de l'écran d'appairage"
            exit 1
            ;;
    esac
    etape_lien
}

# ————————————————————————————————————————————————————————————————————————————————————————————

VERBEUX=0
ARGUMENTS=()
for argument in "$@"; do
    case "$argument" in
        -v) VERBEUX=1 ;;
        *) ARGUMENTS+=("$argument") ;;
    esac
done
COMMANDE="${ARGUMENTS[0]:-tout}"

case "$COMMANDE" in
    tout)
        etape_tests
        etape_apk
        etape_pose
        ;;
    test) etape_tests ;;
    apk) etape_apk ;;
    pose)
        etape_apk
        etape_pose
        ;;
    lien) etape_lien ;;
    appairer) etape_appairer "${ARGUMENTS[@]:1}" ;;
    journal) resume ;;
    plantage) adb logcat -b crash -d | tail -n 40 ;;
    *)
        echo "kokoro [tout|test|apk|pose|lien|appairer|journal|plantage] [-v]"
        exit 1
        ;;
esac
