<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        🔴 `android:icon` est posé sur l'application, pas sur une activité : c'est lui qui donne
        l'icône du lanceur, celle des récents, celle de l'écran de démarrage et celle des réglages
        d'Android. Une seule déclaration, quatre endroits — `companion/README.md` §7.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_lanceur"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Kokoro">

        <activity
            android:name=".crise.CriseActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Kokoro"
            android:turnScreenOn="true" />

        <!--
            🔴 D10 — l'icône du lanceur ouvre le monde. C'est lui l'interface principale de l'app
            depuis companion/README.md §2 ; réglages et check-in sont des panneaux internes, pas des Activity.
        -->
        <activity
            android:name=".monde.MondeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Kokoro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".crise.ReceveurDemarrage"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
